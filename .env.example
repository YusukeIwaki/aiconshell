# Copy to .env and adjust for your machine. Never commit .env itself.
# Every variable used by compose.yml is listed here (`ruby bin/check-compose`
# enforces the coverage). See docs/deployment.md for Railway mapping.
# Compose reads .env automatically; local bin/dev and bin/test runs load it
# via dotenv-rails (development/test only).

# --- Compose project -------------------------------------------------------
# Use one project name per checkout/worktree so volumes and networks never
# collide (e.g. aiconshell-issue8).
COMPOSE_PROJECT_NAME=aiconshell

# --- Rails -----------------------------------------------------------------
RAILS_ENV=development
# fork (compose/Railway) ではプロセスごとの pool なので 5 で足りる。
# macOS の async (`bin/jobs --mode=async`) では全 pool が1プロセスの
# pool を共有するため、worker コマンドに RAILS_MAX_THREADS=15 を明示する
# (README「開発ループ」、docs/deployment.md「同時実作業数と DB pool の目安」)。
RAILS_MAX_THREADS=5
JOB_CONCURRENCY=1

# Rails secret. The compose default is an insecure dev-only fallback; set a
# real value for anything shared (`bin/rails secret`), and always on Railway.
SECRET_KEY_BASE=

# Admin UI credentials (required in every environment; unset fails closed).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# JSON admin API token for POST/GET /api/admin/task_requests (issue #10).
# Separate from the UI Basic credentials; unset or blank fails closed (401).
# Served by web only. See docs/task-requests.md.
ADMIN_API_TOKEN=

# --- PostgreSQL (shared by web + unified worker) ---------------------------
# Web and execution use the SAME DATABASE_URL: one database,
# separate queues. If you change POSTGRES_PASSWORD below, update the password
# inside DATABASE_URL to match.
POSTGRES_USER=aiconshell
POSTGRES_PASSWORD=aiconshell_dev
POSTGRES_DB=aiconshell_development
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aiconshell:aiconshell_dev@db:5432/aiconshell_development

# Test database for the Smartest integration suite (smartest/integration).
# Must resolve to a database whose name ends with _test; db_helper refuses
# to run otherwise so suites can never wipe development data.
TEST_DATABASE_URL=postgresql://aiconshell:aiconshell_dev@127.0.0.1:5432/aiconshell_test

# --- Workflow settings (all Rails processes) --------------------------------
# Read on every Rails boot (WorkflowSettings.validate!). Lease must exceed
# AI timeout + 10s or every process fails to boot. Execution root is
# REQUIRED in production; in compose it is the persisted ai_workspaces
# volume, outside the application source.
AICONSHELL_EXECUTION_ROOT=/workspaces
# Comma-separated "plugin:scope" allowlist for polling and outbound actions
# (e.g. "github:owner/repo,jira:PROJ"). Empty means nothing is polled/sent.
AICONSHELL_ALLOWED_SCOPES=
AICONSHELL_LEASE_SECONDS=1800
AICONSHELL_AI_TIMEOUT_SECONDS=600
AICONSHELL_POLL_LEASE_SECONDS=300
AICONSHELL_MAX_RUN_ATTEMPTS=3
AICONSHELL_MAX_ACTION_ATTEMPTS=5
# "1" enables the explicit deterministic triage fallback. Never silent.
AICONSHELL_DEMO_MODE=

# --- ClickHouse (EventLog search store) --------------------------------------
CLICKHOUSE_DATABASE=aiconshell
CLICKHOUSE_TABLE=event_log
CLICKHOUSE_USER=aiconshell
CLICKHOUSE_PASSWORD=aiconshell_dev
CLICKHOUSE_BIND=127.0.0.1
CLICKHOUSE_PORT=8123
# In-compose service URL (host tools use http://127.0.0.1:${CLICKHOUSE_PORT}).
CLICKHOUSE_URL=http://clickhouse:8123

# --- EventLog emission -------------------------------------------------------
# Default Teams channel captured on each outbox row at emit time
# (config/initializers/event_log.rb). Blank (default) keeps history
# searchable in ClickHouse without Teams notifications; set
# channel:<teamId>/<channelId> (Graph IDs, NOT Bot conversation IDs) to
# enable the Teams sink. Passed to every Rails process (web/
# execution/migrate) because all of them emit events. Not a credential.
EVENT_LOG_TEAMS_CHANNEL=

# --- Web --------------------------------------------------------------------
WEB_BIND=127.0.0.1
WEB_PORT=3000

# --- Worker images -----------------------------------------------------------
# The unified execution worker defaults to `ai` (Claude/Codex/Muse CLIs
# bundled from official public distributions; no build-time login needed).
# Set to `app` for CLI-free offline local verification
# (docs/deployment.md "AI CLI provisioning"). It also runs coordination AI
# (triage). Web, migrate, and clickhouse-init are always `app`
# (no AI CLIs); unconfigured providers stay selectable and fail at
# execution.
EXECUTION_TARGET=ai

# --- Worker role (auth jobs only) --------------------------------------------
# Compose sets this literally on the unified worker (execution); web never
# receives it. Local `bin/jobs --mode=async` runs every queue in one
# process, so set the execution role when exercising the auth queues locally.
# The auth job refuses to run when its role does not match the request.
AICONSHELL_WORKER_ROLE=

# --- AI homes and binaries (unified execution worker only) ------------------
# Private persisted auth homes. The unified worker keeps using the
# execution-side volumes (execution_claude_auth/execution_codex_auth/
# execution_muse_auth). Legacy control-side host volumes are neither
# mounted nor deleted; never copy auth caches between volumes (re-login
# follows docs/ai-connections.md in #20's ops entry).
# Web has no auth mounts and displays worker-confirmed DB snapshots.
CLAUDE_CONFIG_DIR=/private/claude
CODEX_HOME=/private/codex
# Muse XDG config home: the directory CONTAINING the "muse" directory
# (auth at /private/muse/muse/auth.json). No MUSE_CONFIG_DIR exists.
AICONSHELL_MUSE_HOME=/private/muse
# Neutral HOME for AI CLI subprocesses (never the app credentials).
AICONSHELL_AI_HOME=/tmp/aiconshell-ai-home
# Executable paths baked into the ai image (override only for custom builds).
AICONSHELL_CLAUDE_BIN=/usr/local/bin/claude
AICONSHELL_CODEX_BIN=/usr/local/bin/codex
AICONSHELL_MUSE_BIN=/usr/local/bin/muse

# --- Integration credentials (unified execution worker + web) --------------
# Visible to the unified worker's Rails parent (polling, outbound delivery,
# EventLog Teams sink) and to web (admin diagnostics). NEVER on migrate.
# The AI lane never inherits them into CLI subprocesses
# (lib/aiconshell/ai/child_env.rb builds the child env from scratch).
# Leave empty for offline development; plugins report "unconfigured" until
# set. The EventLog Teams sink reuses the Teams plugin credentials on the
# worker.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_FILE=
# Optional GitHub Enterprise/self-hosted API base (default api.github.com).
GITHUB_API_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_API_TOKEN_FILE=
JIRA_SITE_URL=
JIRA_CLOUD_ID=
JIRA_BASE_URL=
# Discord Bot token for mention polling and channel replies/notifications
# (see plugins/discord/README.md). Only the Bot token is used.
DISCORD_BOT_TOKEN=
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_CLIENT_SECRET_FILE=
TEAMS_BOT_APP_ID=
TEAMS_BOT_APP_PASSWORD=
TEAMS_BOT_APP_PASSWORD_FILE=
TEAMS_SERVICE_URL=
# Optional Graph endpoint override (default graph.microsoft.com).
TEAMS_GRAPH_URL=
# Path ONLY (inside web/execution containers) to the private JSON mapping
# Graph channel/message references to Bot conversation references (see
# plugins/teams/README.md). The operator bind-mounts the host file
# read-only (see docs/deployment.md); never commit the file or its values.
TEAMS_BOT_TARGETS_FILE=

# --- User-delegated OAuth (issue #22 foundation) ------------------------------
# Browser-consent connections acting as the consented user (one user per
# provider per environment). Operational names: (1) existing service-account
# Bot operation (JIRA_* / TEAMS_* above), (2) consented-user OAuth2 proxy
# operation (OAUTH_* here). Independent variables; never mixed or reused.
# No personal-PAT operation, PAT input UI, PAT-only plugin, or PAT fallback
# on OAuth failure is provided. See docs/oauth-connections.md.
# The fixed redirect URIs must be registered on the provider app exactly.
# Management UI (#23), delegated adapters (#24/#25), and business wiring
# (#26) arrive separately; offline development leaves these blank and the
# foundation reports "unconfigured" safely.
OAUTH_ATLASSIAN_CLIENT_ID=
OAUTH_ATLASSIAN_CLIENT_SECRET=
OAUTH_ATLASSIAN_CLIENT_SECRET_FILE=
OAUTH_ATLASSIAN_CLOUD_ID=
OAUTH_ATLASSIAN_REDIRECT_URI=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_SECRET_FILE=
OAUTH_MICROSOFT_TENANT_ID=
OAUTH_MICROSOFT_REDIRECT_URI=

# --- Self-actor filtering (unified worker's control pool only) -------------
# "plugin:id" pairs (e.g. "github:12345,teams:bot-id") plus the Jira service
# account: events from these actors are treated as our own echo and skipped
# during polling; Jira outbound fails closed when its self actor is unset.
AICONSHELL_SELF_ACTOR_IDS=
JIRA_SERVICE_ACCOUNT_ID=

# --- ngrok (explicit opt-in; usually unnecessary) ------------------------------
# The app polls external services, so inbound tunnels are rarely needed.
# Set a token and start with: docker compose --profile tunnel up ngrok
# After learning the public URL, allow its exact hostname (no https:// or
# path), e.g. your-assigned-name.ngrok-free.app. Comma-separate multiple
# exact hosts. Rails reads this only in development and only at boot;
# Recreate web after changes. Leave empty without a tunnel; see docs/deployment.md.
RAILS_DEVELOPMENT_HOSTS=
NGROK_AUTHTOKEN=
NGROK_BIND=127.0.0.1
NGROK_PORT=4040
