# Copy to .env and adjust for your machine. Never commit .env itself.
# Web and Solid Queue workers share the single database selected here.

# Development database (also used by bin/jobs workers in development).
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/aiconshell_development

# Test database for the Smartest integration suite (smartest/integration).
# Must resolve to a database whose name ends with _test; db_helper refuses
# to run otherwise so suites can never wipe development data.
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/aiconshell_test

# Web thread count (also sizes the Active Record connection pool via database.yml).
RAILS_MAX_THREADS=5

# Solid Queue worker processes per bin/jobs invocation (see config/queue.yml).
JOB_CONCURRENCY=1
