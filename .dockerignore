# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets.
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Ignore development files
/.devcontainer

# Ignore Docker-related files
/.dockerignore
/Dockerfile*

# Ignore compose / deploy configs (ops wiring, not app code).
/compose*.yml
/compose*.yaml
/railway*.toml
/railway*.json

# Ignore CI, docs, and tests: they must not bloat the runtime image.
/.github/
*.md
**/*.md
/smartest/
/coverage/

# Ignore operator-supplied AI CLI material and local auth caches. The Muse
# binary must enter the `ai` image only via `--secret id=muse_cli`, and
# subscription auth only via mounted volumes, never via the build context.
/vendor/muse-cli/
/.claude/
/.codex/
/.muse/
.ngrok/
