<% content_for(:title, "AIポリシー編集（#{layer_label(@layer)}）") %>
<h1>AIポリシー編集：<%= layer_label(@layer) %>（<%= @layer %>）</h1>
<p><%= link_to "← AIポリシー一覧に戻る", admin_layer_policies_path %></p>

<div class="admin-card">
  <p>現在の設定状態（Web プロセス上の診断）：<%= render "diagnosis_badge", diagnosis: @diagnosis %></p>
  <% if @diagnosis && @diagnosis[:available] && !@diagnosis[:configured] %>
    <p>この provider は未設定ですが保存できます。不足分（CLI・認証配置）は実行前に整備してください。</p>
  <% end %>
  <p>workerでのログインと接続確認は <%= link_to "AIアカウント連携", admin_ai_connections_path %> から行ってください。</p>
  <%= form_with model: @policy, url: admin_layer_policy_path(@layer), method: :patch, scope: :layer_policy do |form| %>
    <div class="admin-form-grid">
      <%= form.label :provider, "provider" %>
      <%= form.select :provider, Admin::AiStatus.providers, { include_blank: "選択してください" }, { required: true } %>
      <%= form.label :model, "model" %>
      <%= form.text_field :model, maxlength: 200 %>
      <%= form.label :effort, "effort" %>
      <%= form.text_field :effort, maxlength: 100 %>
      <%= form.label :enabled, "有効" %>
      <span><%= form.check_box :enabled %> 有効にする</span>
      <%= form.label :instructions, "仕事の指示" %>
      <%= form.text_area :instructions, maxlength: 20_000 %>
    </div>
    <div class="admin-actions">
      <%= form.submit "保存する", class: "admin-btn" %>
    </div>
  <% end %>
</div>
