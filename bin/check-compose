#!/usr/bin/env ruby
# frozen_string_literal: true

# Static operations-config checks (stdlib only, no gems, no Docker, no DB).
#
#   ruby bin/check-compose
#
# Verifies the contracts docs/deployment.md promises: one shared DATABASE_URL,
# the unified execution worker's three separated pools (control / execution /
# ai_auth_execution) plus the recurring scheduler on that same worker, the
# explicit worker role, integration/ClickHouse settings on the worker's Rails
# parent (never in AI child envs), explicit workflow settings on every Rails
# process, the EventLog channel default on every emitting Rails process, Teams
# targets path on web/worker only, recurring schedules targeting control,
# ClickHouse-independent startup (SQL migrate vs clickhouse-init split),
# AI auth only on the worker, persisted workspaces outside app source,
# image role targets (app web/migrate/clickhouse-init, ai worker with an
# explicit app override), pinned Muse download boundaries (no build secret),
# a single migration process, production /up health exclusion, loopback-bound
# ports, no Docker socket mounts, no leftover control-plane startup config,
# and .env.example coverage of every compose variable.
# Runs in CI (ops job) and locally before `docker compose up`.
require "yaml"

ROOT = File.expand_path("..", __dir__)
failures = []

def check(failures, name)
  yield
  puts "check-compose: ok   - #{name}"
  true
rescue StandardError => e
  puts "check-compose: FAIL - #{name}: #{e.message}"
  failures << name
  false
end

def assert(condition, message)
  raise message unless condition
end

WORKFLOW_VARS = %w[
  AICONSHELL_EXECUTION_ROOT AICONSHELL_ALLOWED_SCOPES
  AICONSHELL_LEASE_SECONDS AICONSHELL_AI_TIMEOUT_SECONDS
  AICONSHELL_POLL_LEASE_SECONDS AICONSHELL_MAX_RUN_ATTEMPTS
  AICONSHELL_MAX_ACTION_ATTEMPTS AICONSHELL_DEMO_MODE
].freeze

AI_VARS = %w[
  CLAUDE_CONFIG_DIR CODEX_HOME AICONSHELL_MUSE_HOME AICONSHELL_AI_HOME
  AICONSHELL_CLAUDE_BIN AICONSHELL_CODEX_BIN AICONSHELL_MUSE_BIN
].freeze

INTEGRATION_VARS = %w[
  GITHUB_APP_ID JIRA_EMAIL TEAMS_TENANT_ID DISCORD_BOT_TOKEN GITHUB_API_URL
  TEAMS_GRAPH_URL TEAMS_BOT_TARGETS_FILE
].freeze

POLLING_VARS = %w[
  AICONSHELL_SELF_ACTOR_IDS JIRA_SERVICE_ACCOUNT_ID
].freeze

compose_path = File.join(ROOT, "compose.yml")
compose = YAML.load_file(compose_path, aliases: true)
services = compose.fetch("services")

check(failures, "compose.yml declares web/execution/migrate/clickhouse-init/db/clickhouse (no control)") do
  %w[web execution migrate clickhouse-init db clickhouse].each do |name|
    assert(services.key?(name), "missing service #{name}")
  end
  assert(!services.key?("control"), "obsolete control service must be gone (unified execution worker)")
end

check(failures, "ngrok is opt-in via the tunnel profile") do
  ngrok = services.fetch("ngrok")
  assert(Array(ngrok["profiles"]).include?("tunnel"), "ngrok must carry profiles: [\"tunnel\"]")
end

check(failures, "project name is per-worktree (COMPOSE_PROJECT_NAME)") do
  assert(compose["name"].to_s.include?("COMPOSE_PROJECT_NAME"),
    "top-level name: must reference COMPOSE_PROJECT_NAME")
end

app_services = %w[web execution migrate]
env_of = ->(name) do
  env = services.dig(name, "environment")
  assert(env.is_a?(Hash), "#{name}.environment must be a mapping, got #{env.class}")
  env.transform_keys(&:to_s)
end

check(failures, "web/execution/migrate share one DATABASE_URL") do
  urls = app_services.to_h { |name| [name, env_of.call(name)["DATABASE_URL"]] }
  assert(urls.values.all? { |url| !url.to_s.empty? }, "DATABASE_URL must be set on #{app_services.join(", ")}")
  assert(urls.values.uniq.size == 1, "DATABASE_URL differs: #{urls.keys.join(", ")}")
end

check(failures, "every Rails process receives all WorkflowSettings variables") do
  app_services.each do |name|
    env = env_of.call(name)
    missing = WORKFLOW_VARS.reject { |var| env.key?(var) }
    assert(missing.empty?, "#{name} is missing workflow variables: #{missing.join(", ")} " \
      "(validate! runs on every Rails boot)")
  end
end

check(failures, "execution root is explicit, outside app source, on a persisted volume") do
  roots = app_services.to_h { |name| [name, env_of.call(name)["AICONSHELL_EXECUTION_ROOT"]] }
  assert(roots.values.uniq.size == 1, "AICONSHELL_EXECUTION_ROOT differs: #{roots.values.uniq.inspect}")
  root = roots.values.first.to_s
  assert(root.include?("/workspaces"), "execution root must be /workspaces, got #{root.inspect}")
  assert(!root.include?("/rails"), "execution root must be outside the app source (/rails)")
  mounts = Array(services.dig("execution", "volumes")).map(&:to_s)
  assert(mounts.any? { |mount| mount.include?("ai_workspaces:/workspaces") },
    "execution must mount ai_workspaces at /workspaces")
  assert(compose.fetch("volumes").key?("ai_workspaces"), "missing named volume ai_workspaces")
end

check(failures, "unified worker holds integration/ClickHouse/polling settings in its Rails parent") do
  env = env_of.call("execution")
  INTEGRATION_VARS.each do |var|
    assert(env.key?(var), "execution is missing #{var} (polling/delivery/diagnostics need it)")
  end
  POLLING_VARS.each do |var|
    assert(env.key?(var), "execution is missing #{var} (control-pool poll/outbound filtering)")
  end
  %w[CLICKHOUSE_URL CLICKHOUSE_DATABASE CLICKHOUSE_USER CLICKHOUSE_PASSWORD].each do |var|
    assert(env.key?(var), "execution is missing #{var} (EventLog delivery needs it)")
  end
  # AI subprocess isolation is verified by the behavior tests in
  # smartest/ai/child_env_test.rb and process_runner_test.rb (bin/test unit).
  # This static check only verifies the Rails parent's Compose variables.
end

check(failures, "web has credentials but no polling-only vars; migrate has neither") do
  INTEGRATION_VARS.each do |var|
    assert(env_of.call("web").key?(var), "web is missing #{var} (admin diagnostics)")
  end
  POLLING_VARS.each do |var|
    assert(!env_of.call("web").key?(var), "web must not carry #{var} (worker control-pool only)")
  end
  forbidden = env_of.call("migrate").keys.select do |key|
    key.match?(/\A(GITHUB_|JIRA_|TEAMS_|DISCORD_|CLICKHOUSE_)/) || POLLING_VARS.include?(key)
  end
  assert(forbidden.empty?, "forbidden keys on migrate: #{forbidden.join(", ")}")
end

check(failures, "every emitting Rails process receives EVENT_LOG_TEAMS_CHANNEL (blank default)") do
  app_services.each do |name|
    env = env_of.call(name)
    assert(env.key?("EVENT_LOG_TEAMS_CHANNEL"),
      "#{name} is missing EVENT_LOG_TEAMS_CHANNEL (captured on outbox rows at emit time)")
  end
  example = File.read(File.join(ROOT, ".env.example"))
  assert(example.match?(/^EVENT_LOG_TEAMS_CHANNEL=$/m),
    ".env.example must default EVENT_LOG_TEAMS_CHANNEL to blank")
end

check(failures, "AI auth goes only to execution (corrected muse mapping, no MUSE_CONFIG_DIR)") do
  services.each do |name, svc|
    keys = (svc["environment"] || {}).keys.map(&:to_s)
    assert(!keys.include?("MUSE_CONFIG_DIR"),
      "#{name} sets MUSE_CONFIG_DIR, which the native CLI does not honor (use AICONSHELL_MUSE_HOME)")
  end
  env = env_of.call("execution")
  missing = AI_VARS.reject { |var| env.key?(var) }
  assert(missing.empty?, "execution is missing AI variables: #{missing.join(", ")}")
  %w[web migrate clickhouse-init].each do |name|
    present = env_of.call(name).keys & AI_VARS
    assert(present.empty?, "#{name} must not carry AI variables: #{present.join(", ")}")
  end
  mounts = Array(services.dig("execution", "volumes")).map(&:to_s)
  %w[claude codex muse].each do |provider|
    volume = "execution_#{provider}_auth"
    assert(mounts.include?("#{volume}:/private/#{provider}"), "execution must mount its own #{volume}")
    assert(compose.fetch("volumes").key?(volume), "missing auth volume #{volume}")
  end
  assert(Array(services.dig("web", "volumes")).empty?, "web must mount no AI auth volumes")
end

check(failures, "legacy control auth volumes are neither mounted nor recreated") do
  raw = File.read(compose_path)
  %w[claude_auth codex_auth muse_auth].each do |volume|
    assert(!raw.match?(/(?<!execution_)#{volume}:/),
      "compose must not mount or declare legacy #{volume} (pre-existing host volumes stay untouched)")
  end
end

check(failures, "web/migrate/clickhouse-init stay app, worker defaults to ai with an app override") do
  example = File.read(File.join(ROOT, ".env.example"))
  %w[web migrate clickhouse-init].each do |name|
    target = services.dig(name, "build", "target").to_s
    assert(target == "app", "#{name} build target must be app, got #{target.inspect}")
  end
  target = services.dig("execution", "build", "target").to_s
  assert(target == "${EXECUTION_TARGET:-ai}",
    "execution build target must default to ai via EXECUTION_TARGET for offline app builds (got #{target.inspect})")
  assert(example.match?(/^EXECUTION_TARGET=ai$/), ".env.example must default EXECUTION_TARGET to ai")
  assert(!example.match?(/^CONTROL_TARGET=/m), ".env.example must not define CONTROL_TARGET (no control service)")
  assert(!File.read(compose_path).include?("CONTROL_TARGET"), "base compose must not reference CONTROL_TARGET")
end

check(failures, "obsolete optional-Muse contract is gone (no override, secret, or path)") do
  assert(!File.exist?(File.join(ROOT, "compose.muse.yml")),
    "compose.muse.yml must be removed (muse ships in the ai image by default)")
  example = File.read(File.join(ROOT, ".env.example"))
  assert(!example.match?(/^MUSE_CLI_PATH=/m),
    ".env.example must not define MUSE_CLI_PATH (no operator-supplied binary)")
  assert(!File.read(compose_path).include?("MUSE_CLI_PATH"),
    "base compose must not reference MUSE_CLI_PATH")
  assert(!File.read(compose_path).include?("muse_cli"),
    "base compose must not reference the muse_cli build secret")
end

check(failures, "obsolete control-plane startup config is gone") do
  assert(!File.exist?(File.join(ROOT, "config/queue_control.yml")),
    "config/queue_control.yml must be removed (canonical config is config/queue_execution.yml)")
  assert(!File.exist?(File.join(ROOT, "railway.control.toml")),
    "railway.control.toml must be removed (unified execution worker only)")
  raw = File.read(compose_path)
  assert(!raw.include?("queue_control"), "compose must not reference queue_control")
  assert(!raw.include?("ai_auth_control"), "compose must not reference ai_auth_control")
end

check(failures, "unified worker runs queue_execution.yml with the scheduler (no --skip-recurring)") do
  execution_cmd = Array(services.dig("execution", "command")).join(" ")
  assert(execution_cmd.include?("--config-file=config/queue_execution.yml"), "execution command: #{execution_cmd}")
  assert(!execution_cmd.include?("--skip-recurring"), "execution must keep the recurring scheduler")
end

check(failures, "queue_execution.yml binds three separated pools (control 3 / execution 1 / auth 1)") do
  execution_q = YAML.load_file(File.join(ROOT, "config/queue_execution.yml"))
  workers = Array(execution_q["workers"])
  assert(workers.size == 3, "queue_execution must declare 3 worker pools, got #{workers.size}")
  by_queue = workers.to_h { |worker| [Array(worker["queues"]).map(&:to_s), worker] }
  control_pool = by_queue[["control"]]
  execution_pool = by_queue[["execution"]]
  auth_pool = by_queue[["ai_auth_execution"]]
  assert(control_pool, "queue_execution must bind a dedicated control pool")
  assert(execution_pool, "queue_execution must bind a dedicated execution pool")
  assert(auth_pool, "queue_execution must bind a dedicated ai_auth_execution pool")
  assert(control_pool["threads"].to_i == 3, "control pool must default to 3 threads")
  assert(execution_pool["threads"].to_i == 1, "execution pool must default to 1 thread")
  assert(auth_pool["threads"].to_i == 1, "ai_auth_execution pool must be 1 thread")
  workers.each do |worker|
    queues = Array(worker["queues"]).map(&:to_s)
    assert(queues.size == 1 && queues.first != "*", "pools must not be wildcard or merged: #{queues.inspect}")
  end
end

check(failures, "development queue.yml mirrors the same three-pool separation (no wildcard)") do
  dev_q = YAML.load_file(File.join(ROOT, "config/queue.yml"), aliases: true)
  workers = Array(dev_q.dig("development", "workers"))
  assert(workers.size == 3, "queue.yml development must declare 3 worker pools, got #{workers.size}")
  by_queue = workers.to_h { |worker| [Array(worker["queues"]).map(&:to_s), worker] }
  assert(by_queue[["control"]]["threads"].to_i == 3, "queue.yml control pool must default to 3 threads")
  assert(by_queue[["execution"]]["threads"].to_i == 1, "queue.yml execution pool must default to 1 thread")
  assert(by_queue[["ai_auth_execution"]]["threads"].to_i == 1, "queue.yml auth pool must be 1 thread")
  workers.each do |worker|
    queues = Array(worker["queues"]).map(&:to_s)
    assert(queues.size == 1 && queues.first != "*", "pools must not be wildcard or merged: #{queues.inspect}")
  end
end

check(failures, "worker carries the execution role, web/migrate carry none") do
  assert(env_of.call("execution")["AICONSHELL_WORKER_ROLE"] == "execution", "execution role")
  %w[web migrate clickhouse-init].each do |name|
    env = services.dig(name, "environment") || {}
    assert(!env.transform_keys(&:to_s).key?("AICONSHELL_WORKER_ROLE"), "#{name} must not carry AICONSHELL_WORKER_ROLE")
  end
  job_file = File.join(ROOT, "app/jobs/ai_auth_job.rb")
  assert(File.file?(job_file), "missing app/jobs/ai_auth_job.rb for the auth queue")
  job_source = File.read(job_file)
  # Final contract (default unification is #20's scope; this file is not
  # edited here): AiAuthJob must default to ai_auth_execution. A
  # pre-integration tree still declaring ai_auth_control fails this check;
  # report that failure as the known #20 dependency instead of accepting
  # the old queue.
  assert(job_source.match?(/queue_as :ai_auth_execution/),
    "AiAuthJob must declare queue_as :ai_auth_execution (final contract; pre-#20 trees fail here as a known dependency)")
  request_source = File.read(File.join(ROOT, "app/services/ai_auth/request_service.rb"))
  assert(request_source.include?("ai_auth_"), "RequestService must reserve the ai_auth role queue")
end

check(failures, "recurring schedules wire all control jobs in development and production") do
  expected = {
    "integration_poll_schedule" => { "class" => "IntegrationPollScheduleJob", "schedule" => "every 5 minutes" },
    "coordination_triage" => { "class" => "CoordinationTriageJob", "schedule" => "every minute" },
    "lease_recovery" => { "class" => "LeaseRecoveryJob", "schedule" => "every minute" },
    "workflow_maintenance" => { "class" => "WorkflowMaintenanceJob", "schedule" => "every minute" },
    "event_log_delivery" => { "class" => "EventLogDeliveryJob", "schedule" => "every minute" },
    "clear_solid_queue_finished_jobs" => { "command" => true, "schedule" => "every hour at minute 12" }
  }
  recurring = YAML.load_file(File.join(ROOT, "config/recurring.yml"), aliases: true)
  assert(!recurring.key?("test"), "test must not auto-schedule recurring tasks")
  %w[development production].each do |env|
    tasks = recurring[env]
    assert(tasks.is_a?(Hash), "#{env} section must be a mapping")
    missing = expected.keys - tasks.keys.map(&:to_s)
    extra = tasks.keys.map(&:to_s) - expected.keys
    assert(missing.empty?, "#{env} is missing recurring tasks: #{missing.join(", ")}")
    assert(extra.empty?, "#{env} has unexpected recurring tasks: #{extra.join(", ")}")
    expected.each do |key, spec|
      task = tasks[key] || tasks[key.to_sym]
      assert(task["schedule"].to_s == spec["schedule"], "#{env}.#{key} schedule: #{task["schedule"].inspect}")
      assert(task["queue"].to_s == "control", "#{env}.#{key} must target queue control")
      if spec["command"]
        assert(!task["command"].to_s.empty?, "#{env}.#{key} needs its cleanup command")
      else
        assert(task["class"].to_s == spec["class"], "#{env}.#{key} class: #{task["class"].inspect}")
        assert(task["args"].nil?, "#{env}.#{key} must not pass args (job-side defaults)")
        underscore = spec["class"].gsub(/([A-Z]+)([A-Z][a-z])/, '\1_\2')
          .gsub(/([a-z\d])([A-Z])/, '\1_\2').downcase
        job_file = File.join(ROOT, "app/jobs/#{underscore}.rb")
        assert(File.file?(job_file), "missing #{job_file} for #{env}.#{key}")
        assert(File.read(job_file).include?("queue_as :control"),
          "#{job_file} must declare queue_as :control")
      end
    end
  end
end

check(failures, "production keeps force_ssl but excludes /up from the redirect") do
  production = File.read(File.join(ROOT, "config/environments/production.rb"))
  assert(production.match?(/^\s*config\.force_ssl = true\s*$/),
    "production must keep force_ssl (HTTPS for admin)")
  assert(production.match?(/config\.ssl_options = \{ redirect: \{ exclude:.*request\.path == "\/up"/m),
    "production must exclude /up from the SSL redirect (Railway healthcheck)")
end

check(failures, "exactly one SQL migration setup process (migrate service)") do
  assert(env_of.call("migrate")["AICONSHELL_RUN_DB_SETUP"] == "1", "migrate must set AICONSHELL_RUN_DB_SETUP=1")
  %w[web execution clickhouse-init].each do |name|
    assert(env_of.call(name)["AICONSHELL_RUN_DB_SETUP"].nil?, "#{name} must not run SQL setup")
  end
  %w[web execution].each do |name|
    dep = services.dig(name, "depends_on", "migrate", "condition")
    assert(dep == "service_completed_successfully", "#{name} must wait for migrate (got #{dep.inspect})")
  end
  clickhouse_keys = env_of.call("migrate").keys.select { |key| key.start_with?("CLICKHOUSE_") }
  assert(clickhouse_keys.empty?, "migrate must not need ClickHouse: #{clickhouse_keys.join(", ")}")
end

check(failures, "ClickHouse outage never blocks startup (independent clickhouse-init)") do
  init = services.fetch("clickhouse-init")
  cmd = Array(init["command"]).join(" ")
  assert(cmd.include?("bin/setup-clickhouse"), "clickhouse-init command: #{cmd}")
  assert(init["restart"] == "no", "clickhouse-init must be one-shot (restart: no)")
  dep = init.dig("depends_on", "clickhouse", "condition")
  assert(dep == "service_healthy", "clickhouse-init must wait for clickhouse healthy")
  init_env = init.fetch("environment").transform_keys(&:to_s)
  assert(init_env.key?("CLICKHOUSE_URL"), "clickhouse-init needs the clickhouse-client variables")
  %w[web execution migrate].each do |name|
    assert(services.dig(name, "depends_on", "clickhouse").nil?,
      "#{name} must not depend on clickhouse (EventLog is eventually consistent)")
  end
end

check(failures, "no service uses env_file (allow-listed environment only)") do
  with_env_file = services.select { |_name, svc| svc.key?("env_file") }.keys
  assert(with_env_file.empty?, "env_file on: #{with_env_file.join(", ")}")
end

check(failures, "no Docker socket mount anywhere") do
  raw = File.read(compose_path)
  assert(!raw.include?("docker.sock"), "compose.yml references docker.sock")
end

check(failures, "published ports bind loopback by default") do
  services.each do |name, svc|
    Array(svc["ports"]).each do |port|
      text = port.to_s
      assert(text.start_with?("127.0.0.1") || text.match?(/\A\$\{[A-Z_]+:-127\.0\.0\.1\}/),
        "#{name} port #{text.inspect} is not loopback-bound by default")
    end
  end
end

check(failures, "db/clickhouse/web define healthchecks") do
  %w[db clickhouse web].each do |name|
    assert(services.dig(name, "healthcheck", "test"), "#{name} has no healthcheck.test")
  end
end

check(failures, "Dockerfile defaults to app, ai carries git and pinned muse download") do
  dockerfile = File.read(File.join(ROOT, "Dockerfile"))
  stages = dockerfile.scan(/^FROM \S+ AS (\S+)/).flatten
  assert(stages.include?("ai"), "missing ai stage")
  assert(dockerfile.include?("AICONSHELL_EXECUTION_ROOT=/tmp/aiconshell-build-root ./bin/rails assets:precompile"),
    "assets:precompile must set a dummy AICONSHELL_EXECUTION_ROOT (production boot validates it)")
  assert(stages.last == "runtime" && dockerfile.include?("ARG RUNTIME_TARGET=app") &&
    dockerfile.include?('FROM ${RUNTIME_TARGET} AS runtime'),
    "runtime must default to app and accept an explicit ai target for Railway workers")
  assert(dockerfile.include?("USER 1000:1000"), "runtime must drop to non-root")
  assert(!dockerfile.include?("muse_cli"),
    "Dockerfile must not use the muse_cli build secret (official public download instead)")
  assert(dockerfile.match?(/^ARG MUSE_VERSION=\d+\.\d+\.\d+-R\d+(?:\.\d+)?$/),
    "muse version must be pinned via MUSE_VERSION")
  %w[AMD64 ARM64].each do |arch|
    assert(dockerfile.match?(/^ARG MUSE_SHA256_#{arch}=[0-9a-f]{64}$/),
      "muse #{arch} digest must be pinned via MUSE_SHA256_#{arch}")
  end
  assert(dockerfile.include?("muse-x86-linux") && dockerfile.include?("muse-aarch64-linux"),
    "muse download must select the per-arch native artifact")
  assert(dockerfile.include?('"https://lookaside.facebook.com/lookaside/muse/download/?channel=muse&version=${MUSE_VERSION}&file=${MUSE_ARTIFACT}"'),
    "muse download URL must be the quoted official public artifact URL")
  assert(dockerfile.include?("sha256sum -c"),
    "muse download must verify the SHA256 checksum")
  assert(dockerfile.include?("install -m 0755 /tmp/muse /usr/local/bin/muse"),
    "muse binary must be installed at /usr/local/bin/muse with mode 0755")
  assert(dockerfile.include?("muse --version"),
    "ai stage must verify muse --version at build time")
  ai_stage = dockerfile.split(/^FROM \S+ AS ai\s*$/).last.split(/^FROM /).first
  assert(ai_stage.match?(/apt-get install [^\n]*\bgit\b/),
    "ai stage must install git for engineering commands")
  assert(ai_stage.include?("/usr/local/bin/muse"),
    "muse install must live in the ai stage only")
  app_stage = dockerfile.split(/^FROM base AS app\s*$/).last.split(/^FROM /).first
  assert(!app_stage.include?("/usr/local/bin/muse"),
    "app stage must not install muse")
  assert(dockerfile.include?("/workspaces"), "image must provide /workspaces (execution root)")
  assert(!dockerfile.include?("MUSE_CONFIG_DIR"), "Dockerfile must not reference MUSE_CONFIG_DIR")
end

check(failures, ".env.example documents every compose variable") do
  example = File.read(File.join(ROOT, ".env.example"))
  raw = File.read(compose_path)
  vars = raw.scan(/\$\{([A-Z][A-Z0-9_]*)/).flatten.uniq
  missing = vars.reject { |var| example.match?(/^#{var}=/m) }
  assert(missing.empty?, "undocumented variables: #{missing.join(", ")}")
end

check(failures, "CI runs all suites with required services and no live providers") do
  ci_path = File.join(ROOT, ".github/workflows/ci.yml")
  ci = YAML.load_file(ci_path)
  jobs = ci.fetch("jobs")
  %w[unit integration zeitwerk ops clickhouse-smoke].each do |job|
    assert(jobs.key?(job), "CI missing job #{job}")
  end
  raw = File.read(ci_path)
  assert(raw.include?("bin/test unit"), "CI unit job must run bin/test unit")
  assert(raw.include?("bin/test integration"), "CI integration job must run bin/test integration")
  assert(raw.include?("zeitwerk:check"), "CI must run zeitwerk:check")
  services_used = (jobs.dig("integration", "services") || {}).keys.map(&:to_s)
  assert(services_used.include?("postgres"), "CI integration job must run a postgres service")
  assert(services_used.include?("clickhouse"), "CI integration job must run a clickhouse service")
  assert(raw.include?("TEST_CLICKHOUSE_URL"), "CI integration must set TEST_CLICKHOUSE_URL (fail fast, never silently skip)")
  %w[claude codex muse].each do |cli|
    assert(raw.include?("/usr/local/bin/#{cli}") && raw.include?("--version"),
      "CI ops job must --version the pinned #{cli} Linux CLI")
  end
  assert(raw.include?("command -v"), "CI ops job must fail when the app image carries AI CLIs")
  assert(!raw.include?("compose.muse.yml"), "CI must not reference the removed muse override config")
  assert(!raw.include?("MUSE_CLI_PATH"), "CI must not reference MUSE_CLI_PATH")
  assert(!raw.include?("muse_cli"), "CI must not reference the muse_cli build secret")
  assert(!raw.include?("CONTROL_TARGET"), "CI must not reference CONTROL_TARGET (no control service)")
  assert(!raw.include?("queue_control"), "CI must not reference queue_control (canonical config is queue_execution)")
  assert(!raw.include?("railway.control"), "CI must not reference railway.control (unified worker only)")
  %w[NGROK_AUTHTOKEN CLAUDE_CODE_OAUTH_TOKEN OPENAI_API_KEY].each do |secret|
    assert(!raw.include?(secret), "CI must not reference #{secret}")
  end
end

check(failures, "Railway predeploy runs SQL only (ClickHouse setup is separate)") do
  railway = File.read(File.join(ROOT, "railway.toml"))
  assert(railway.include?('preDeployCommand = "./bin/rails db:prepare"'),
    "railway predeploy must be SQL-only db:prepare")
  assert(!railway.match?(/^preDeployCommand.*setup-clickhouse/m),
    "railway predeploy must not couple ClickHouse setup to deploys")
end

check(failures, "Railway worker runs the unified queue config with the scheduler") do
  worker = File.read(File.join(ROOT, "railway.execution.toml"))
  assert(worker.include?("--config-file=config/queue_execution.yml"),
    "railway worker must start with config/queue_execution.yml")
  assert(!worker.include?("--skip-recurring"),
    "railway worker must keep the recurring scheduler (no --skip-recurring)")
  assert(!worker.include?("queue_control"), "railway worker must not reference queue_control")
end

puts "check-compose: failures=#{failures.size}"
exit(failures.empty? ? 0 : 1)
